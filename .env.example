# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External Supabase / PostgreSQL Configuration
# If unconfigured, the system defaults to its built-in server-side relational database
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Python FastAPI Geospatial Worker (GDAL/OGR, Rasterio, GeoPandas, PyProj, OpenCV)
# If unconfigured, client/server reports "Service not configured" and uses lightweight Turf.js
GEOSPATIAL_WORKER_URL="http://localhost:8000"

# JWT Secret for authorized server-side session tokens
JWT_SECRET="meivilam-auth-secret-key-salt-2026"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform services
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_GOOGLE_MAPS_API_KEY=""

# URL for the Python model service
MODEL_SERVICE_URL="http://localhost:8000"
